rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Deliverables & Orders: allow read and write for automated order deliverables & UI inspection
    match /orders/{allPaths=**} {
      allow read, write: if true;
    }
    match /deliverables/{allPaths=**} {
      allow read, write: if true;
    }
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}

