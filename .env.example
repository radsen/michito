# ==============================================================================
# Michito B2B Engine — Environment Configuration Specification (.env.example)
# Clean Architecture • Multi-Environment • Secrets Specification
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server
# ------------------------------------------------------------------------------
# Active environment: development, staging, or production
ENVIRONMENT=development
PORT=8000

# ------------------------------------------------------------------------------
# 2. Database & Persistence (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Local development default:
DATABASE_URL=postgresql+psycopg://michito_admin:michito_secure_pass@127.0.0.1:5432/michito
# Google Cloud SQL (Production with Cloud SQL Auth Proxy):
# DATABASE_URL=postgresql+psycopg://michito_user:PASSWORD@127.0.0.1:5432/michito_prod
# SQLite fallback (offline tests):
# DATABASE_URL=sqlite:///michito_orders.db

# Component credentials for local Docker Compose or migration scripts:
POSTGRES_USER=michito_admin
POSTGRES_PASSWORD=michito_secure_pass
POSTGRES_DB=michito
DB_USER=michito_app
DB_PASSWORD=
DB_NAME=michito

# ------------------------------------------------------------------------------
# 3. Cloud Object Storage & Decoupled Workers
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=chiketto-michito
GOOGLE_CLOUD_PROJECT=chiketto-michito
GCP_REGION=us-central1
GCS_BUCKET_NAME=michito-deliverables
CLOUD_RUN_JOB_NAME=michito-batch-worker

# Local Firebase Storage Emulator (leave blank in production):
STORAGE_EMULATOR_HOST=localhost:9199

# ------------------------------------------------------------------------------
# 4. Message Broker (Google Cloud Pub/Sub)
# ------------------------------------------------------------------------------
ENABLE_PUBSUB_QUEUE=false
PUBSUB_TOPIC_ORDERS=michito-orders
PUBSUB_SUBSCRIPTION_WORKER=michito-worker-sub

# Local Pub/Sub Emulator (leave blank in production):
PUBSUB_EMULATOR_HOST=localhost:8085

# ------------------------------------------------------------------------------
# 5. Payment Gateway (Wompi Colombia — Sandbox / Dev Keys)
# Source: Chiketto HEBI Account-Receivable Integration (/Users/radsen/dev/tinkko/account-recievable)
# ------------------------------------------------------------------------------
WOMPI_PUBLIC_KEY=pub_test_IcBzwUvqUDy85sD7i3snlgxvMLj4A1eL
WOMPI_INTEGRITY_SECRET=test_integrity_r5SIpk6PnYywRaCxQlOXgySj28wNNlmj
WOMPI_EVENTS_SECRET=test_events_wmhM2301jwX2c9q8u4SofthtnAKUO7aK
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/

# ------------------------------------------------------------------------------
# 6. Messaging & WhatsApp Conversational Bot (Meta Cloud API / Twilio)
# ------------------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=michito_wa_token
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=109283746501928

# ------------------------------------------------------------------------------
# 7. Official Public Registries API Access (Higher Rate Limits)
# ------------------------------------------------------------------------------
# Colombia SECOP II SODA API Token (datos.gov.co):
SECOP_APP_TOKEN=

# Dominican Republic DGCP Portal Key:
DGCP_API_KEY=

# ------------------------------------------------------------------------------
# 8. Outbound Alerting & Slack Observability (Incoming Webhooks)
# ------------------------------------------------------------------------------
# Critical errors, Dead-Letter Queue (DLQ), and scraping engine alerts:
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Business activity, new orders, lead delivery, and payment notifications:
ORDERS_FEED_WEBHOOK_URL=https://hooks.slack.com/services/...

# ------------------------------------------------------------------------------
# 9. AI Agent Intelligence Suite (Gemini Flash & Brief Compiler)
# ------------------------------------------------------------------------------
# Google AI Studio API Key for Gemini Flash brief compiler (gemini-2.5-flash / gemini-1.5-flash).
# When left empty, Michito seamlessly falls back to its sub-millisecond local BM25 ISIC index ($0.00 cost).
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 10. Security & Protected Administrative Endpoints
# ------------------------------------------------------------------------------
# Secret administrative API key for operations like manual order replay or cache clears:
ADMIN_API_KEY=michito_admin_secret_key_change_in_prod
# Ephemeral token signing secret for Server-Sent Events (SSE) telemetry stream:
STREAM_SECRET_KEY=michito_stream_signing_secret_dev

# ------------------------------------------------------------------------------
# 11. Omnichannel Email Delivery (SMTP)
# ------------------------------------------------------------------------------
# Automated customer fulfillment dispatch (deliverables attachment):
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM=entregas@michito.co
SMTP_USE_TLS=true



