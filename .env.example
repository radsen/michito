# ==============================================================================
# Michito B2B Engine — Environment Configuration Specification (.env.example)
# Clean Architecture • Multi-Environment • Secrets Specification
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server
# ------------------------------------------------------------------------------
# Active environment: development, staging, or production
ENVIRONMENT=development
PORT=8000

# ------------------------------------------------------------------------------
# 2. Database & Persistence (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Local development default:
DATABASE_URL=postgresql+psycopg://michito_admin:michito_secure_pass@127.0.0.1:5432/michito
# Google Cloud SQL (Production with Cloud SQL Auth Proxy):
# DATABASE_URL=postgresql+psycopg://michito_user:PASSWORD@127.0.0.1:5432/michito_prod
# SQLite fallback (offline tests):
# DATABASE_URL=sqlite:///michito_orders.db

# ------------------------------------------------------------------------------
# 3. Cloud Object Storage (Deliverables & Signed URLs)
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=chiketto-michito
GCS_BUCKET_NAME=michito-deliverables

# Local Firebase Storage Emulator (leave blank in production):
STORAGE_EMULATOR_HOST=localhost:9199

# ------------------------------------------------------------------------------
# 4. Message Broker (Google Cloud Pub/Sub)
# ------------------------------------------------------------------------------
PUBSUB_TOPIC_ORDERS=michito-orders
PUBSUB_SUBSCRIPTION_WORKER=michito-worker-sub

# Local Pub/Sub Emulator (leave blank in production):
PUBSUB_EMULATOR_HOST=localhost:8085

# ------------------------------------------------------------------------------
# 5. Payment Gateway (Wompi Colombia — Sandbox / Dev Keys)
# Source: Chiketto HEBI Account-Receivable Integration (/Users/radsen/dev/tinkko/account-recievable)
# ------------------------------------------------------------------------------
WOMPI_PUBLIC_KEY=pub_test_IcBzwUvqUDy85sD7i3snlgxvMLj4A1eL
WOMPI_INTEGRITY_SECRET=test_integrity_r5SIpk6PnYywRaCxQlOXgySj28wNNlmj
WOMPI_EVENTS_SECRET=test_events_wmhM2301jwX2c9q8u4SofthtnAKUO7aK
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/

# ------------------------------------------------------------------------------
# 6. Messaging & WhatsApp Conversational Bot (Meta Cloud API / Twilio)
# ------------------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=michito_wa_token
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=109283746501928

# ------------------------------------------------------------------------------
# 7. Official Public Registries API Access (Higher Rate Limits)
# ------------------------------------------------------------------------------
# Colombia SECOP II SODA API Token (datos.gov.co):
SECOP_APP_TOKEN=

# Dominican Republic DGCP Portal Key:
DGCP_API_KEY=

